<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <AssemblyName>WriteFix</AssemblyName>
    <RootNamespace>WriteFix</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Assets\writefix.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.2.0</Version>
    <Product>WriteFix</Product>
    <Description>Instant message corrector for English and French.</Description>
    <!-- Properties > Details on WriteFix.exe. The company publishes it, the
         author owns it; the installer repeats both (installer\WriteFix.iss). -->
    <Company>iSoutien</Company>
    <Authors>Moad Dahbi</Authors>
    <Copyright>Copyright (c) 2026 Moad Dahbi</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DiffPlex" Version="1.9.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\writefix.ico" />
  </ItemGroup>

</Project>
