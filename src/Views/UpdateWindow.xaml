<Window x:Class="WriteFix.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WriteFix update"
        Width="560" SizeToContent="Height"
        MinHeight="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/writefix.ico"
        Background="{StaticResource Canvas}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Grid Background="{StaticResource Canvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Same dark masthead as Settings, so the update reads as part of the app. -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceDark}"
                CornerRadius="0,0,22,22" Padding="26,20">
            <Grid ClipToBounds="True">
                <Ellipse Width="230" Height="230" HorizontalAlignment="Right"
                         VerticalAlignment="Top" Margin="0,-160,-60,0"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="{StaticResource HeaderGlowColor}" Offset="0" />
                            <GradientStop Color="{StaticResource HeaderGlowTransparentColor}" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <StackPanel>
                    <TextBlock x:Name="HeadlineText"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="20" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock x:Name="SubheadText" Margin="0,4,0,0" FontSize="12"
                               Foreground="{StaticResource HeaderForegroundSoft}" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="24,20,24,0">
            <TextBlock Text="What changed" Style="{StaticResource FieldLabel}" />
            <Border Background="{StaticResource Well}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1"
                    CornerRadius="11" Padding="14,12">
                <ScrollViewer x:Name="NotesScroller" MaxHeight="190"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="NotesText" TextWrapping="Wrap"
                               FontSize="12" LineHeight="18"
                               Foreground="{StaticResource InkSoft}" />
                </ScrollViewer>
            </Border>

            <!-- Collapsed until Update now is pressed; nothing downloads before that. -->
            <ProgressBar x:Name="DownloadBar" Height="6" Margin="0,16,0,0"
                         Minimum="0" Maximum="1000"
                         Visibility="Collapsed"
                         Background="{StaticResource Well}"
                         BorderBrush="{StaticResource Border}"
                         Foreground="{StaticResource Accent}" />

            <TextBlock x:Name="StatusText" Style="{StaticResource HelpText}"
                       Margin="0,10,0,0" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"
                       Visibility="Collapsed" />
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource FooterSurface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"
                Padding="24,14" Margin="0,20,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" x:Name="SkipBox" VerticalAlignment="Center"
                          Style="{StaticResource FieldCheck}"
                          AutomationProperties.Name="Skip this version"
                          Content="Skip this version" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="LaterButton" Content="Later"
                            Style="{StaticResource QuietButton}"
                            IsCancel="True" Click="OnLater" />
                    <Button x:Name="UpdateButton" Content="Update now"
                            Style="{StaticResource PrimaryButton}"
                            Margin="9,0,0,0" MinWidth="120"
                            IsDefault="True" Click="OnUpdate" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
