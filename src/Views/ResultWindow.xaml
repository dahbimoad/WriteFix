<Window x:Class="WriteFix.Views.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WriteFix"
        Width="570"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="Manual">

    <Border x:Name="CardShell" Margin="18,18,28,30"
            Background="{StaticResource Paper}"
            BorderBrush="{StaticResource Border}"
            BorderThickness="1"
            CornerRadius="20"
            Effect="{StaticResource FloatingShadow}"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TranslateTransform x:Name="CardEntranceTransform" Y="7" />
        </Border.RenderTransform>

        <Grid Margin="18,16,18,17">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="10"
                            Background="{StaticResource Accent}"
                            VerticalAlignment="Center">
                        <Viewbox Width="21" Height="21">
                            <Canvas Width="64" Height="64">
                                <Path Data="M16 21 L21 40 L25 30 L27 30 L31 40 L36 19"
                                      Stroke="White" StrokeThickness="7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                                <Path Data="M48 18 C48 23 50 25 55 25 C50 25 48 27 48 32 C48 27 46 25 41 25 C46 25 48 23 48 18 Z"
                                      Fill="White" />
                                <Path Data="M47 35.5 C47 38 48 39 50.5 39 C48 39 47 40 47 42.5 C47 40 46 39 43.5 39 C46 39 47 38 47 35.5 Z"
                                      Fill="White" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="WriteFix" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="13.5" FontWeight="SemiBold" />
                        <TextBlock Text="Refine without leaving your flow"
                                   FontSize="10.5" Foreground="{StaticResource InkSoft}"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border x:Name="ModeChip"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="{StaticResource AccentSoft}"
                        BorderBrush="{StaticResource AccentBorder}" BorderThickness="1"
                        CornerRadius="10" Padding="9,4">
                    <TextBlock x:Name="ModeChipText" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{StaticResource HighlightInk}" />
                </Border>
            </Grid>

            <!-- Body: exactly one state is visible at a time. -->
            <Grid Grid.Row="1">
                <Border x:Name="WorkingPanel" Background="{StaticResource Well}"
                        BorderBrush="{StaticResource Border}" BorderThickness="1"
                        CornerRadius="14" Padding="16,15" Margin="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="34" Height="34" VerticalAlignment="Center">
                            <Ellipse Width="27" Height="27" Fill="{StaticResource AccentSoft}" />
                            <Ellipse Width="13" Height="13" Fill="{StaticResource AccentHalo}" />
                            <Ellipse x:Name="Pulse" Width="8" Height="8"
                                     Fill="{StaticResource Accent}"
                                     Effect="{StaticResource SignalGlow}" />
                        </Grid>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Refining your writing…"
                                       FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="Keeping your meaning, improving the delivery."
                                       FontSize="10.5" Foreground="{StaticResource InkSoft}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="ErrorPanel" Visibility="Collapsed"
                        Background="{StaticResource AccentSoft}"
                        BorderBrush="{StaticResource AccentBorder}" BorderThickness="1"
                        CornerRadius="14" Padding="14,12" Margin="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource Danger}"
                                CornerRadius="2" />
                        <TextBlock Grid.Column="1" x:Name="ErrorText" FontSize="11.5"
                                   TextWrapping="Wrap" LineHeight="17"
                                   AutomationProperties.LiveSetting="Assertive"
                                   Foreground="{StaticResource Ink}" Margin="11,1,1,1" />
                    </Grid>
                </Border>

                <StackPanel x:Name="ResultPanel" Visibility="Collapsed">
                    <ScrollViewer MaxHeight="270" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Border Background="{StaticResource Well}"
                                BorderBrush="{StaticResource Border}" BorderThickness="1"
                                CornerRadius="14" Padding="15,12">
                            <TextBlock x:Name="ResultText" Style="{StaticResource ProseText}" />
                        </Border>
                    </ScrollViewer>

                    <TextBlock x:Name="NoticeText" Style="{StaticResource HelpText}"
                               Visibility="Collapsed" Margin="2,8,2,0"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{StaticResource HighlightInk}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="HintText" VerticalAlignment="Center"
                           FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                           Foreground="{StaticResource InkSoft}" Margin="0,0,12,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CancelButton" Content="Cancel"
                            Style="{StaticResource QuietButton}"
                            IsCancel="True" Click="OnCancel" />
                    <Button x:Name="RegenerateButton" Content="Regenerate"
                            Style="{StaticResource QuietButton}"
                            Margin="7,0,0,0" Click="OnRegenerate" />
                    <Button x:Name="CopyButton" Content="Copy"
                            Style="{StaticResource QuietButton}"
                            Margin="7,0,0,0" Click="OnCopy" />
                    <Button x:Name="AcceptButton" Content="Accept"
                            Style="{StaticResource PrimaryButton}"
                            Margin="7,0,0,0" IsDefault="True" Click="OnAccept" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
