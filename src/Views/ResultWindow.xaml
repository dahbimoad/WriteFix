<Window x:Class="WriteFix.Views.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WriteFix"
        Width="540"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="Manual">

    <Border Margin="14"
            Background="{StaticResource Surface}"
            BorderBrush="{StaticResource Border}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.22" Color="#000000" />
        </Border.Effect>

        <Grid Margin="16,13,16,13">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,11">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="9" Height="9" CornerRadius="3"
                            Background="{StaticResource AccentGradient}" VerticalAlignment="Center" />
                    <TextBlock Text="WriteFix" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" />
                </StackPanel>

                <Border x:Name="ModeChip"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="{StaticResource SurfaceMuted}"
                        CornerRadius="10" Padding="8,3">
                    <TextBlock x:Name="ModeChipText" FontSize="11" Foreground="{StaticResource InkSoft}" />
                </Border>
            </Grid>

            <!-- Body: exactly one of these three is visible at a time -->
            <Grid Grid.Row="1">

                <StackPanel x:Name="WorkingPanel" Orientation="Horizontal" Margin="0,10,0,16">
                    <Border x:Name="Pulse" Width="12" Height="12" CornerRadius="6"
                            Background="{StaticResource AccentGradient}" VerticalAlignment="Center" />
                    <TextBlock Text="Working…" FontSize="14" Margin="10,0,0,0"
                               Foreground="{StaticResource InkSoft}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" Margin="0,2,0,12">
                    <TextBlock x:Name="ErrorText" FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource Danger}" />
                </StackPanel>

                <StackPanel x:Name="ResultPanel" Visibility="Collapsed">
                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Border Background="{StaticResource SurfaceMuted}" CornerRadius="8" Padding="11,9">
                            <TextBlock x:Name="ResultText" FontSize="14" TextWrapping="Wrap"
                                       LineHeight="21" />
                        </Border>
                    </ScrollViewer>

                    <TextBlock x:Name="NoticeText" Style="{StaticResource HelpText}"
                               Visibility="Collapsed" Margin="2,7,0,0" />
                </StackPanel>
            </Grid>

            <!-- Actions -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="HintText" VerticalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource InkSoft}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource QuietButton}"
                            IsCancel="True" Click="OnCancel" />
                    <Button x:Name="RegenerateButton" Content="Regenerate" Style="{StaticResource QuietButton}"
                            Margin="7,0,0,0" Click="OnRegenerate" />
                    <Button x:Name="CopyButton" Content="Copy" Style="{StaticResource QuietButton}"
                            Margin="7,0,0,0" Click="OnCopy" />
                    <Button x:Name="AcceptButton" Content="Accept" Style="{StaticResource PrimaryButton}"
                            Margin="7,0,0,0" IsDefault="True" Click="OnAccept" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
