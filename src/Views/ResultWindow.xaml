<Window x:Class="WriteFix.Views.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WriteFix"
        Width="540"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="Manual">

    <!-- Margin leaves room for the hard offset shadow, which is drawn outside the border. -->
    <Border Margin="10,10,16,16"
            Background="{StaticResource Paper}"
            BorderBrush="{StaticResource Ink}"
            BorderThickness="2"
            Effect="{StaticResource HardShadow}">

        <Grid Margin="15,12,15,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,11">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="10" Height="10"
                            Background="{StaticResource Amber}"
                            BorderBrush="{StaticResource Ink}" BorderThickness="2"
                            VerticalAlignment="Center" />
                    <TextBlock Text="WriteFix" FontSize="12" FontWeight="Bold" Margin="9,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Border x:Name="ModeChip"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="{StaticResource AmberSoft}"
                        BorderBrush="{StaticResource Ink}" BorderThickness="2"
                        Padding="7,1">
                    <TextBlock x:Name="ModeChipText" FontSize="10" FontWeight="Bold" />
                </Border>
            </Grid>

            <!-- Body: exactly one of these three is visible at a time -->
            <Grid Grid.Row="1">

                <StackPanel x:Name="WorkingPanel" Orientation="Horizontal" Margin="0,8,0,14">
                    <Border x:Name="Pulse" Width="12" Height="12"
                            Background="{StaticResource Amber}"
                            BorderBrush="{StaticResource Ink}" BorderThickness="2"
                            VerticalAlignment="Center" />
                    <TextBlock Text="Working…" FontSize="12.5" Margin="11,0,0,0"
                               Foreground="{StaticResource InkSoft}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" Margin="0,2,0,12">
                    <Border Background="{StaticResource Well}"
                            BorderBrush="{StaticResource Danger}" BorderThickness="0,0,0,0"
                            Padding="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Fill="{StaticResource Danger}" />
                            <TextBlock Grid.Column="1" x:Name="ErrorText" FontSize="11.5"
                                       TextWrapping="Wrap" LineHeight="17"
                                       Foreground="{StaticResource Ink}" Margin="10,8,10,8" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="ResultPanel" Visibility="Collapsed">
                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Border Background="{StaticResource Well}"
                                BorderBrush="{StaticResource Ink}" BorderThickness="2"
                                Padding="11,9">
                            <!-- The one block set in prose, not monospace: this is the
                                 sentence about to be sent, and it should read fast. -->
                            <TextBlock x:Name="ResultText" Style="{StaticResource ProseText}" />
                        </Border>
                    </ScrollViewer>

                    <TextBlock x:Name="NoticeText" Style="{StaticResource HelpText}"
                               Visibility="Collapsed" Margin="0,7,0,0" />
                </StackPanel>
            </Grid>

            <!-- Actions -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="HintText" VerticalAlignment="Center" FontSize="10.5"
                           Foreground="{StaticResource InkSoft}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource QuietButton}"
                            IsCancel="True" Click="OnCancel" />
                    <Button x:Name="RegenerateButton" Content="Regenerate" Style="{StaticResource QuietButton}"
                            Margin="8,0,0,0" Click="OnRegenerate" />
                    <Button x:Name="CopyButton" Content="Copy" Style="{StaticResource QuietButton}"
                            Margin="8,0,0,0" Click="OnCopy" />
                    <Button x:Name="AcceptButton" Content="Accept" Style="{StaticResource PrimaryButton}"
                            Margin="8,0,0,0" IsDefault="True" Click="OnAccept" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
