<Window x:Class="WriteFix.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WriteFix Settings"
        Width="720" Height="820"
        MinWidth="640" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/writefix.ico"
        Background="{StaticResource Canvas}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Grid Background="{StaticResource Canvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The restrained dark masthead gives the warm workspace a precise edge. -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceDark}"
                CornerRadius="0,0,22,22" Padding="28,23">
            <Grid ClipToBounds="True">
                <Ellipse Width="260" Height="260" HorizontalAlignment="Right"
                         VerticalAlignment="Top" Margin="0,-170,-70,0"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="{StaticResource HeaderGlowColor}" Offset="0" />
                            <GradientStop Color="{StaticResource HeaderGlowTransparentColor}" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Viewbox Width="48" Height="48" VerticalAlignment="Center">
                            <Canvas Width="64" Height="64">
                                <Path Data="M20 6 H44 C52.8 6 60 13.2 60 22 V40 C60 48.8 52.8 56 44 56 H6 V22 C6 13.2 13.2 6 20 6 Z"
                                      Fill="{StaticResource Accent}" Stroke="#101010"
                                      StrokeThickness="4" StrokeLineJoin="Miter" />
                                <Path Data="M16 21 L21 40 L25 30 L27 30 L31 40 L36 19"
                                      Fill="Transparent" Stroke="#101010" StrokeThickness="7"
                                      StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"
                                      StrokeLineJoin="Miter" />
                                <Path Data="M48 18 C48 23 50 25 55 25 C50 25 48 27 48 32 C48 27 46 25 41 25 C46 25 48 23 48 18 Z"
                                      Fill="#101010" />
                                <Path Data="M47 35.5 C47 38 48 39 50.5 39 C48 39 47 40 47 42.5 C47 40 46 39 43.5 39 C46 39 47 38 47 35.5 Z"
                                      Fill="#101010" />
                            </Canvas>
                        </Viewbox>

                        <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="WriteFix" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="22" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="Write less. Say it better."
                                       FontSize="12" Foreground="{StaticResource HeaderForegroundSoft}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" VerticalAlignment="Center"
                            Background="{StaticResource HeaderChipBackground}"
                            BorderBrush="{StaticResource HeaderChipBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="12,7">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}"
                                     Effect="{StaticResource SignalGlow}" VerticalAlignment="Center" />
                            <TextBlock Text="English + French" Margin="8,0,0,0"
                                       FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource HeaderForeground}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <ScrollViewer x:Name="Scroller" Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,22,20,30"
                      Focusable="False">
            <StackPanel>
                <TextBlock Text="Make WriteFix yours"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="A few thoughtful choices shape every correction."
                           Style="{StaticResource SectionSubtitle}" FontSize="12.5"
                           Margin="0,4,0,20" />

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="20,18,20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="9" Height="9" CornerRadius="5"
                                    Background="{StaticResource Accent}" Margin="0,5,11,0"
                                    VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="AI connection" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Secure access and the model that powers your corrections."
                                           Style="{StaticResource SectionSubtitle}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="20,18,20,20">
                            <TextBlock Text="OpenRouter API key" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <PasswordBox Grid.Column="0" x:Name="ApiKeyBox"
                                             Style="{StaticResource FieldPassword}"
                                             AutomationProperties.Name="OpenRouter API key"
                                             VerticalContentAlignment="Center" />
                                <Button Grid.Column="1" x:Name="TestButton" Content="Test"
                                        Margin="9,0,0,0" Style="{StaticResource QuietButton}"
                                        Click="OnTestConnection" />
                                <Button Grid.Column="2" x:Name="ClearKeyButton" Content="Clear"
                                        Margin="8,0,0,0" Style="{StaticResource QuietButton}"
                                        Click="OnClearKey" />
                            </Grid>
                            <TextBlock x:Name="KeyStatusText" Style="{StaticResource HelpText}" />

                            <Border Height="1" Background="{StaticResource Border}" Margin="0,18" />

                            <TextBlock Text="Model" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="ModelBox" IsEditable="True"
                                      Style="{StaticResource FieldCombo}"
                                      AutomationProperties.Name="OpenRouter model"
                                      MaxDropDownHeight="220"
                                      PreviewMouseWheel="OnNestedScroll" />
                            <TextBlock Style="{StaticResource HelpText}"
                                       Text="Free models are rate-limited. Paid models such as Claude Haiku are usually faster and more consistent." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="20,18,20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="9" Height="9" CornerRadius="5"
                                    Background="{StaticResource Accent}" Margin="0,5,11,0"
                                    VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Writing style" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Set the tone while WriteFix protects the meaning of your message."
                                           Style="{StaticResource SectionSubtitle}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="20,18,20,20">
                            <Border Background="{StaticResource AccentSoft}"
                                    BorderBrush="{StaticResource AccentBorder}" BorderThickness="1"
                                    CornerRadius="12" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="24" Height="24" CornerRadius="12"
                                            Background="{StaticResource Accent}"
                                            VerticalAlignment="Top">
                                        <Viewbox Width="13" Height="13">
                                            <Path Data="M 6,1 L 11,3 L 11,7 C 11,10 9,12 6,13 C 3,12 1,10 1,7 L 1,3 Z"
                                                  Fill="Transparent" Stroke="White" StrokeThickness="1.5" />
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Always protected" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="{StaticResource HighlightInk}" />
                                        <TextBlock Margin="0,5,0,0" FontSize="11.5" LineHeight="17"
                                                   TextWrapping="Wrap" Foreground="{StaticResource ProtectedText}"
                                                   Text="WriteFix rewrites rather than answers, keeps English or French unchanged, and returns only the corrected text." />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Margin="0,18,0,7">
                                <TextBlock Text="Your instructions" Style="{StaticResource FieldLabel}"
                                           Margin="0" VerticalAlignment="Center" />
                                <Button x:Name="ResetPromptButton" Content="Reset to default"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Style="{StaticResource MicroButton}" Click="OnResetPrompt" />
                            </Grid>

                            <TextBox x:Name="PromptBox" Style="{StaticResource FieldBox}"
                                     AutomationProperties.Name="Correction style instructions"
                                     Height="150" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     PreviewMouseWheel="OnNestedScroll" />
                            <TextBlock Style="{StaticResource HelpText}"
                                       Text="Describe tone, formality, or wording to preserve. Changes apply to the next correction without restarting WriteFix." />

                            <Expander Style="{StaticResource QuietExpander}" Margin="0,15,0,0"
                                      Expanded="OnPreviewExpanded">
                                <Expander.Header>
                                    <TextBlock Text="Preview the complete model prompt"
                                               FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource InkSoft}" />
                                </Expander.Header>
                                <Border Background="{StaticResource Well}"
                                        BorderBrush="{StaticResource Border}" BorderThickness="1"
                                        CornerRadius="11" Padding="13,11" Margin="0,10,0,0">
                                    <TextBlock x:Name="PromptPreview" FontSize="11.5"
                                               TextWrapping="Wrap" LineHeight="17"
                                               Foreground="{StaticResource InkSoft}" />
                                </Border>
                            </Expander>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel Margin="20,18,20,20">
                            <TextBlock Text="Keyboard shortcut" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Summon WriteFix from any message."
                                       Style="{StaticResource SectionSubtitle}" Margin="0,3,0,14" />
                            <TextBox x:Name="HotkeyBox" Style="{StaticResource FieldBox}"
                                     AutomationProperties.Name="WriteFix keyboard shortcut"
                                     HorizontalAlignment="Stretch" FontFamily="{StaticResource MonoFont}"
                                     FontWeight="SemiBold" IsReadOnly="True" Cursor="Hand"
                                     TextAlignment="Center" PreviewKeyDown="OnHotkeyKeyDown" />
                            <TextBlock Style="{StaticResource HelpText}"
                                       Text="Click, then press a combination with Ctrl, Alt, Shift, or Win." />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel Margin="20,18,20,20">
                            <TextBlock Text="Ready when you are" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Keep the assistant quietly available."
                                       Style="{StaticResource SectionSubtitle}" Margin="0,3,0,16" />
                            <Border Background="{StaticResource Well}" CornerRadius="11" Padding="13,11">
                                <StackPanel>
                                    <CheckBox x:Name="StartupBox" Style="{StaticResource FieldCheck}"
                                              AutomationProperties.Name="Start WriteFix with Windows"
                                              Content="Start with Windows" />
                                    <TextBlock Text="Launches quietly in the tray when you sign in."
                                               Style="{StaticResource HelpText}" Margin="31,6,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource FooterSurface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="FooterStatus" VerticalAlignment="Center"
                           FontSize="11.5" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="{StaticResource InkSoft}" Margin="0,0,18,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Run in background" Style="{StaticResource QuietButton}"
                            AutomationProperties.Name="Run WriteFix in background"
                            IsCancel="True" Click="OnRunInBackground" />
                    <Button x:Name="SaveButton" Content="Save changes"
                            Style="{StaticResource PrimaryButton}"
                            Margin="9,0,0,0" MinWidth="112"
                            IsDefault="True" Click="OnSave" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
