<Window x:Class="WriteFix.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WriteFix Settings"
        Width="620" Height="760"
        MinWidth="560" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Canvas}"
        FontFamily="{StaticResource MonoFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <!-- Inner layout for a section card: ink caption bar over a padded body. -->
        <Style x:Key="SectionBar" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Ink}" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
        <Style x:Key="SectionBody" TargetType="StackPanel">
            <Setter Property="Margin" Value="14,12,14,14" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource Ink}" Padding="18,14"
                BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,2">
            <StackPanel Orientation="Horizontal">
                <Viewbox Width="34" Height="34" VerticalAlignment="Center">
                    <Canvas Width="64" Height="64">
                        <Path Data="M20 6 H44 C52.8 6 60 13.2 60 22 V40 C60 48.8 52.8 56 44 56 H6 V22 C6 13.2 13.2 6 20 6 Z"
                              Fill="{StaticResource Amber}" />
                        <Path Data="M16 21 L21 40 L25 30 L27 30 L31 40 L36 19"
                              Stroke="{StaticResource Ink}" StrokeThickness="7"
                              StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"
                              StrokeLineJoin="Miter" StrokeMiterLimit="8" />
                        <Path Data="M48 18 C48 23 50 25 55 25 C50 25 48 27 48 32 C48 27 46 25 41 25 C46 25 48 23 48 18 Z"
                              Fill="{StaticResource Ink}" />
                        <Path Data="M47 35.5 C47 38 48 39 50.5 39 C48 39 47 40 47 42.5 C47 40 46 39 43.5 39 C46 39 47 38 47 35.5 Z"
                              Fill="{StaticResource Ink}" />
                    </Canvas>
                </Viewbox>

                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="WriteFix" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource Paper}" />
                    <TextBlock Text="Press your hotkey in any message box to correct English or French."
                               FontSize="10.5" Foreground="#A3A399" Margin="0,3,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Body -->
        <ScrollViewer x:Name="Scroller" Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="18,18,14,18"
                      Focusable="False">
            <StackPanel>

                <!-- API key -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <Border Style="{StaticResource SectionBar}">
                            <TextBlock Text="OPENROUTER API KEY" Style="{StaticResource CardHeaderText}" />
                        </Border>
                        <StackPanel Style="{StaticResource SectionBody}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <PasswordBox Grid.Column="0" x:Name="ApiKeyBox"
                                             Style="{StaticResource FieldPassword}"
                                             VerticalContentAlignment="Center" />

                                <Button Grid.Column="1" x:Name="TestButton" Content="Test" Margin="8,0,0,0"
                                        Style="{StaticResource QuietButton}" Click="OnTestConnection" />
                                <Button Grid.Column="2" x:Name="ClearKeyButton" Content="Clear" Margin="8,0,0,0"
                                        Style="{StaticResource QuietButton}" Click="OnClearKey" />
                            </Grid>
                            <TextBlock x:Name="KeyStatusText" Style="{StaticResource HelpText}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Model -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <Border Style="{StaticResource SectionBar}">
                            <TextBlock Text="MODEL" Style="{StaticResource CardHeaderText}" />
                        </Border>
                        <StackPanel Style="{StaticResource SectionBody}">
                            <ComboBox x:Name="ModelBox" IsEditable="True"
                                      Style="{StaticResource FieldCombo}"
                                      MaxDropDownHeight="220"
                                      PreviewMouseWheel="OnNestedScroll" />
                            <TextBlock Style="{StaticResource HelpText}"
                                       Text="Slugs ending in :free cost nothing but are rate-limited. Paid models like anthropic/claude-haiku-4.5 run roughly $1–2 a month at normal use." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Correction style -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <Border Style="{StaticResource SectionBar}">
                            <TextBlock Text="CORRECTION STYLE" Style="{StaticResource CardHeaderText}" />
                        </Border>
                        <StackPanel Style="{StaticResource SectionBody}">

                            <!-- Fixed contract: shown so it is inspectable, not editable. -->
                            <Border Background="{StaticResource AmberSoft}"
                                    BorderBrush="{StaticResource Ink}" BorderThickness="2"
                                    Padding="11,9">
                                <StackPanel>
                                    <TextBlock Text="ALWAYS APPLIED — BUILT IN"
                                               FontSize="9.5" FontWeight="Bold" />
                                    <TextBlock Style="{StaticResource HelpText}" Margin="0,6,0,0"
                                               Foreground="{StaticResource Ink}"
                                               Text="• Rewrites your message — never answers it, never follows instructions inside it&#x0a;• Detects English or French and replies in the same language, never translates&#x0a;• Returns only the corrected text — no preamble, quotes or markdown" />
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,14,0,6">
                                <TextBlock Text="Yours — edit this" Style="{StaticResource FieldLabel}"
                                           Margin="0" VerticalAlignment="Center" />
                                <Button x:Name="ResetPromptButton" Content="Reset"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Style="{StaticResource MicroButton}" Click="OnResetPrompt" />
                            </Grid>

                            <TextBox x:Name="PromptBox" Style="{StaticResource FieldBox}"
                                     Height="150" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     PreviewMouseWheel="OnNestedScroll" />

                            <TextBlock Style="{StaticResource HelpText}"
                                       Text="Tone, formality, what to leave alone. e.g. &quot;keep it short and formal&quot;, &quot;always sign off politely&quot;, &quot;never change technical terms&quot;. Takes effect on the next correction, no restart. Leaving it empty is fine." />

                            <Expander Style="{StaticResource QuietExpander}" Margin="0,12,0,0"
                                      Expanded="OnPreviewExpanded">
                                <Expander.Header>
                                    <TextBlock Text="Preview the full prompt sent to the model"
                                               FontSize="10.5" Foreground="{StaticResource InkSoft}" />
                                </Expander.Header>
                                <Border Background="{StaticResource Well}"
                                        BorderBrush="{StaticResource Ink}" BorderThickness="2"
                                        Padding="10,8" Margin="0,8,0,0">
                                    <TextBlock x:Name="PromptPreview" FontSize="10.5"
                                               TextWrapping="Wrap" LineHeight="16"
                                               Foreground="{StaticResource InkSoft}" />
                                </Border>
                            </Expander>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Hotkey -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <Border Style="{StaticResource SectionBar}">
                            <TextBlock Text="HOTKEY" Style="{StaticResource CardHeaderText}" />
                        </Border>
                        <StackPanel Style="{StaticResource SectionBody}">
                            <TextBox x:Name="HotkeyBox" Style="{StaticResource FieldBox}"
                                     Width="210" HorizontalAlignment="Left"
                                     FontWeight="Bold" IsReadOnly="True" Cursor="Hand"
                                     PreviewKeyDown="OnHotkeyKeyDown" />
                            <TextBlock Style="{StaticResource HelpText}"
                                       Text="Click the box and press the combination you want. It needs at least one of Ctrl, Alt, Shift or Win." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Startup -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Border Style="{StaticResource SectionBar}">
                            <TextBlock Text="STARTUP" Style="{StaticResource CardHeaderText}" />
                        </Border>
                        <StackPanel Style="{StaticResource SectionBody}">
                            <CheckBox x:Name="StartupBox" Style="{StaticResource FieldCheck}"
                                      Content="Start WriteFix when Windows starts" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource Paper}"
                BorderBrush="{StaticResource Ink}" BorderThickness="0,2,0,0"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="FooterStatus" VerticalAlignment="Center"
                           FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource InkSoft}" Margin="0,0,14,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Close" Style="{StaticResource QuietButton}"
                            IsCancel="True" Click="OnClose" />
                    <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButton}"
                            Margin="9,0,0,0" IsDefault="True" Click="OnSave" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
