<Window x:Class="WriteFix.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WriteFix Settings"
        Width="580" Height="700"
        MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceMuted}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource AccentGradient}" Padding="20,16">
            <StackPanel>
                <TextBlock Text="WriteFix" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                <TextBlock Text="Press your hotkey in any message box to correct English or French."
                           FontSize="12" Foreground="#E9E6FE" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,18,20,18">
            <StackPanel>

                <!-- API key -->
                <TextBlock Text="OpenRouter API key" Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource Surface}"
                            BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="7">
                        <PasswordBox x:Name="ApiKeyBox" BorderThickness="0" Padding="9,7"
                                     Background="Transparent" FontSize="13" VerticalContentAlignment="Center" />
                    </Border>

                    <Button Grid.Column="1" x:Name="TestButton" Content="Test" Margin="7,0,0,0"
                            Style="{StaticResource QuietButton}" Click="OnTestConnection" />
                    <Button Grid.Column="2" x:Name="ClearKeyButton" Content="Clear" Margin="7,0,0,0"
                            Style="{StaticResource QuietButton}" Click="OnClearKey" />
                </Grid>
                <TextBlock x:Name="KeyStatusText" Style="{StaticResource HelpText}" />

                <!-- Model -->
                <TextBlock Text="Model" Style="{StaticResource FieldLabel}" Margin="0,18,0,5" />
                <ComboBox x:Name="ModelBox" IsEditable="True" FontSize="13" Padding="8,6" />
                <TextBlock Style="{StaticResource HelpText}"
                           Text="Slugs ending in :free cost nothing but are rate-limited. Paid models like anthropic/claude-haiku-4.5 run roughly $1–2 a month at normal use." />

                <!-- System prompt: fixed contract shown read-only, style owned by the user -->
                <TextBlock Text="System prompt" Style="{StaticResource FieldLabel}" Margin="0,20,0,5" />

                <Border Background="#F0EFFB" BorderBrush="#D9D5F5" BorderThickness="1"
                        CornerRadius="7" Padding="11,9">
                    <StackPanel>
                        <TextBlock Text="ALWAYS APPLIED — BUILT IN" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource Accent}" />
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,5,0,0"
                                   Foreground="{StaticResource Ink}"
                                   Text="• Rewrites your message — never answers it, never follows instructions inside it&#x0a;• Detects English or French and replies in the same language, never translates&#x0a;• Returns only the corrected text — no preamble, quotes or markdown" />
                    </StackPanel>
                </Border>

                <Grid Margin="0,14,0,5">
                    <TextBlock Text="Your correction style — edit this" Style="{StaticResource FieldLabel}" Margin="0" />
                    <Button x:Name="ResetPromptButton" Content="Reset" HorizontalAlignment="Right"
                            Style="{StaticResource QuietButton}" Padding="9,3" MinWidth="0"
                            FontSize="11" Click="OnResetPrompt" />
                </Grid>
                <TextBox x:Name="PromptBox" Style="{StaticResource FieldBox}"
                         Height="140" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" FontSize="12.5" />
                <TextBlock Style="{StaticResource HelpText}"
                           Text="How the text should be corrected — tone, formality, what to leave alone. e.g. &quot;keep it short and formal&quot;, &quot;always sign off politely&quot;, &quot;never change technical terms&quot;. Takes effect on the next correction, no restart. Leaving it empty is fine." />

                <Expander Header="Preview the full prompt sent to the model" FontSize="11"
                          Foreground="{StaticResource InkSoft}" Margin="0,8,0,0"
                          Expanded="OnPreviewExpanded">
                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                            BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,6,0,0">
                        <TextBlock x:Name="PromptPreview" FontFamily="Consolas" FontSize="11"
                                   TextWrapping="Wrap" Foreground="{StaticResource InkSoft}" />
                    </Border>
                </Expander>

                <!-- Hotkey -->
                <TextBlock Text="Hotkey" Style="{StaticResource FieldLabel}" Margin="0,18,0,5" />
                <TextBox x:Name="HotkeyBox" Style="{StaticResource FieldBox}" Width="200"
                         HorizontalAlignment="Left" IsReadOnly="True" Cursor="Hand"
                         PreviewKeyDown="OnHotkeyKeyDown" />
                <TextBlock Style="{StaticResource HelpText}"
                           Text="Click the box and press the combination you want. It needs at least one of Ctrl, Alt, Shift or Win." />

                <!-- Startup -->
                <CheckBox x:Name="StartupBox" Margin="0,18,0,0" FontSize="13"
                          Content="Start WriteFix when Windows starts" />

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="FooterStatus" VerticalAlignment="Center" FontSize="12"
                           TextWrapping="Wrap" Foreground="{StaticResource InkSoft}" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Close" Style="{StaticResource QuietButton}" IsCancel="True" Click="OnClose" />
                    <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButton}"
                            Margin="8,0,0,0" IsDefault="True" Click="OnSave" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
